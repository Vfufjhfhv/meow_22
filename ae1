--==================================================
-- RAKNET FAST PATH (DEBUG VERSION)
--==================================================

local rk_mod = raknet
local HAS_RK = type(rk_mod) == "table" and type(rk_mod.send) == "function" and type(rk_mod.add_send_hook) == "function"

local rn = {
    capturing = false,
    expect = nil,
    timeout = 0,
    payloadLen = 0,
    template = nil,
    offset = 0,
    priority = 1,
    reliability = 1,
    ready = false,
    disabled = false,
    failCount = 0,
}

if HAS_RK then
    rk_mod.add_send_hook(function(packet)
        if not rn.capturing then return end
        if os.clock() > rn.timeout then rn.capturing = false; return end
        
        -- Lấy dữ liệu thô (thử nhiều thuộc tính khác nhau)
        local data = packet.AsString or packet.Data or packet.Payload or packet.RawData
        if type(data) ~= "string" then 
            print("[77 Debug] Packet không có dữ liệu dạng string!")
            return 
        end

        local off = string.find(data, rn.expect, 1, true)
        
        if off then
            -- Tìm thấy payload!
            rn.template    = data
            rn.offset      = off
            rn.payloadLen  = #rn.expect
            rn.priority    = packet.Priority or 1
            rn.reliability = packet.Reliability or 3
            rn.ready       = true
            rn.capturing   = false
            print(string.format("[77] RakNet CAPTURED! Size: %dB, Offset: %d", #data, off))
        else
            -- Không tìm thấy, debug xem có nén không
            print(string.format("[77 Debug] Hook bắt được packet (%dB) nhưng KHÔNG khớp payload.", #data))
            -- In thử 50 byte đầu để xem cấu trúc
            print("[77 Debug] Hex: " .. string.format("%02X", string.byte(data, 1, 50)):gsub(" ", ""))
            rn.capturing = false
        end
    end)
    print("[77 Debug] Đã đăng ký Hook RakNet thành công.")
else
    warn("[77 Debug] Không tìm thấy thư viện RakNet!")
end

local function rk_fireReal(payload, cam)
    if HAS_RK and not rn.ready and not rn.disabled then
        rn.capturing = true
        rn.expect    = payload
        rn.timeout   = os.clock() + 2 -- Đợi tối đa 2 giây để hook bắt
        print("[77 Debug] Đang gửi FireServer thật để lấy template...")
    end
    
    cachedFireServer(cachedRemote, cachedHash, cachedKey,
        payload, 0.5, cam, events, aimPos, false)
        
    -- Không tắt rn.capturing ở đây, để hook tự tắt sau khi bắt được
end

local function rk_fireFast(payload)
    if not rn.ready or #payload ~= rn.payloadLen then return false end
    local data = string.sub(rn.template, 1, rn.offset - 1)
        .. payload
        .. string.sub(rn.template, rn.offset + rn.payloadLen)
    local ok, res = pcall(rk_mod.send, data, rn.priority, rn.reliability)
    return ok and res ~= false
end

local function rk_fire(payload, cam)
    if not rn.ready or rn.disabled then
        rk_fireReal(payload, cam)
        return
    end
    if rk_fireFast(payload) then
        rn.failCount = 0
        return
    end
    rn.failCount += 1
    if rn.failCount >= 5 then
        rn.disabled = true
        warn("[77] RakNet disabled — fallback FireServer")
    end
    rk_fireReal(payload, cam)
end
