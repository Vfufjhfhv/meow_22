local heartbeatConn
local lastTs = 0

local function startExecuteLoop()
    if heartbeatConn then return end

    lastTs = 0
    State.Accumulator = 0

    heartbeatConn = RunService.PreSimulation:Connect(function(dt)
        -- 1. Tính số gói cần bắn trong frame này (TargetRPS = 100)
        State.Accumulator += dt * State.TargetRPS
        local fires = math_floor(State.Accumulator)
        if fires < 1 then return end
        State.Accumulator -= fires

        -- 2. Kiểm tra bộ đệm
        if not captureReady and not initCaptureCache() then
            local cam = camCF
            if cam then
                for _ = 1, fires do tryFallback(cam, events, aimPos) end
            end
            return
        end

        local cam = camCF
        if not cam then return end

        -- 3. Lấy mốc thời gian cơ sở
        local baseTs = math_floor(getServerTimeNow(Workspace) * 100)
        local bytes = cachedTransformedBytes

        -- 4. Bắn Burst nhẹ (1-2 gói/frame)
        for i = 1, fires do
            -- Đảm bảo Timestamp nhích lên từng gói
            if baseTs <= lastTs then
                baseTs = lastTs + 1
            end
            lastTs = baseTs

            local ts = tostring_(baseTs)
            local payload

            -- Build Payload
            if #ts == 12 then
                local b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12 = string_byte(ts, 1, 12)
                payload = string_char(
                    bit32_bxor(b1  + 1,  bytes[1]),  bit32_bxor(b2  + 2,  bytes[2]),
                    bit32_bxor(b3  + 3,  bytes[3]),  bit32_bxor(b4  + 4,  bytes[4]),
                    bit32_bxor(b5  + 5,  bytes[5]),  bit32_bxor(b6  + 6,  bytes[6]),
                    bit32_bxor(b7  + 7,  bytes[7]),  bit32_bxor(b8  + 8,  bytes[8]),
                    bit32_bxor(b9  + 9,  bytes[9]),  bit32_bxor(b10 + 10, bytes[10]),
                    bit32_bxor(b11 + 11, bytes[11]), bit32_bxor(b12 + 12, bytes[12])
                )
            else
                local len = #ts
                local chars = table_create(len)
                for j = 1, len do
                    chars[j] = string_char(bit32_bxor(string_byte(ts, j) + j, bytes[j]))
                end
                payload = table_concat(chars)
            end

            cachedFireServer(
                cachedRemote, cachedHash, cachedKey,
                payload, 0.5, cam, events, aimPos, false
            )
        end
    end)
end
